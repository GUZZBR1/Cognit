{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognit.dev/schemas/browser-baseline-trial-record-v1.schema.json",
  "title": "Cognit Browser Baseline TrialRecord v1 (local adapter snapshot)",
  "description": "Per-attempt automated control record. This local adapter contract does not define the canonical row-level schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_version", "record_id", "manifest_id", "framework", "tool_version", "browser", "browser_version", "cognit_commit", "protocol_version", "config", "config_sha256", "seed", "session_id", "attempt_id", "challenge_id", "evidence_class", "actor_class", "oracle_access", "oracle_source", "observed_result", "perception_metric_eligible", "target_source", "target_origin"],
  "properties": {
    "record_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "manifest_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "framework": {"enum": ["playwright", "selenium", "puppeteer"]},
    "tool_version": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "browser": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "browser_version": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "cognit_commit": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "protocol_version": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "config": {"type": "object"},
    "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "seed": {"oneOf": [{"type": "string", "minLength": 1, "pattern": "\\S"}, {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991}]},
    "session_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "attempt_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "challenge_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "evidence_class": {"const": "SIMULATED"},
    "actor_class": {"const": "AUTOMATION_CONTROLLED"},
    "oracle_access": {"const": true},
    "oracle_source": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "observed_result": {"type": "object"},
    "perception_metric_eligible": {"const": false},
    "human_ground_truth": {"const": null},
    "target_source": {"const": "cognit-fixed-demo"},
    "target_origin": {"type": "string", "pattern": "^http://(?:localhost|127\\.0\\.0\\.1|\\[::1\\])(?::(?:80|(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{2}|6553[0-5])))?$"}
  }
}
