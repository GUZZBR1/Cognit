{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognit.dev/schemas/trial-record-v1/schema.json",
  "title": "Cognit TrialRecord v1",
  "description": "Canonical per-attempt record. Study, protocol, build, environment, and shared configuration are resolved through manifest_ref.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "trial_id", "session_id", "actor", "label", "provenance", "manifest_ref", "challenge_ref", "outcome", "started_at", "ended_at", "evidence_class", "oracle_access"],
  "properties": {
    "contract_version": { "const": "trial-record-v1" },
    "trial_id": { "type": "string", "pattern": "^trial-[a-f0-9]{16,64}$", "description": "Opaque identifier; do not encode personal information." },
    "session_id": { "type": "string", "pattern": "^session-[a-f0-9]{16,64}$", "description": "Opaque identifier; do not encode personal information." },
    "participant_id": { "type": "string", "pattern": "^participant-[a-f0-9]{16,64}$", "description": "Optional study-scoped pseudonym. Never use a civil identity." },
    "actor": { "enum": ["HUMAN_CONFIRMED", "AUTOMATION_CONTROL", "AI_AGENT", "UNKNOWN"] },
    "label": { "enum": ["human", "automation", "ai_agent", null] },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "independent", "valid"],
      "properties": {
        "source": { "enum": ["independent-human-review", "independent-agent-review", "controlled-automation", "accessibility-review", "oracle-control", "unknown"] },
        "independent": { "type": "boolean" },
        "valid": { "type": "boolean" }
      }
    },
    "manifest_ref": {
      "type": "object", "additionalProperties": false, "required": ["manifest_id", "sha256", "version"],
      "properties": {
        "manifest_id": { "type": "string", "pattern": "^manifest-[a-f0-9]{16,64}$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "challenge_ref": {
      "type": "object", "additionalProperties": false, "required": ["challenge_id", "seed_ref", "config_hash"],
      "properties": {
        "challenge_id": { "type": "string", "pattern": "^challenge-[a-f0-9]{16,64}$" },
        "seed_ref": { "type": "string", "pattern": "^seed-[a-f0-9]{16,64}$" },
        "config_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "outcome": {
      "type": "object", "additionalProperties": false, "required": ["status", "duration_ms"],
      "properties": {
        "status": { "enum": ["completed", "failed", "abandoned", "unknown"] },
        "duration_ms": { "type": ["number", "null"], "minimum": 0 },
        "observations": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "risk_score": { "type": "number", "minimum": 0, "maximum": 1 },
            "prediction": { "enum": ["human", "automation", "ai_agent", "unknown"] },
            "policy": { "enum": ["allow", "block", "challenge", "unknown"] },
            "protected_action_reached": { "type": ["boolean", "null"], "description": "Whether the protected action was observed in this attempt; absent or null means UNKNOWN and must never be inferred as false." },
            "protected_action_reached_provenance": {
              "type": "object", "additionalProperties": false,
              "required": ["trial_id", "source", "method", "origin", "observed_at"],
              "properties": {
                "trial_id": { "type": "string", "pattern": "^trial-[a-f0-9]{16,64}$", "description": "Must equal the enclosing TrialRecord trial_id." },
                "source": { "type": "string", "minLength": 1 },
                "method": { "type": "string", "minLength": 1 },
                "origin": { "type": "string", "minLength": 1 },
                "observed_at": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "evidence_class": { "enum": ["human_report", "automation", "agent", "unknown", "accessible", "oracle_assisted"] },
    "oracle_access": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "properties": {
              "observations": {
                "properties": { "protected_action_reached": { "type": "boolean" } },
                "required": ["protected_action_reached"]
              }
            }
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "outcome": {
            "properties": {
              "observations": { "required": ["protected_action_reached_provenance"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "actor": { "const": "UNKNOWN" } }, "required": ["actor"] },
      "then": { "properties": { "label": { "type": "null" }, "evidence_class": { "const": "unknown" } } }
    },
    {
      "if": { "properties": { "label": { "type": "string" } }, "required": ["label"] },
      "then": {
        "properties": {
          "provenance": {
            "properties": { "independent": { "const": true }, "valid": { "const": true } },
            "not": { "properties": { "source": { "enum": ["unknown", "oracle-control"] } }, "required": ["source"] }
          }
        }
      }
    },
    {
      "if": { "properties": { "oracle_access": { "const": true } }, "required": ["oracle_access"] },
      "then": { "properties": { "evidence_class": { "const": "oracle_assisted" }, "label": { "type": "null" } } },
      "else": { "properties": { "evidence_class": { "not": { "const": "oracle_assisted" } } } }
    },
    {
      "if": { "properties": { "actor": { "const": "HUMAN_CONFIRMED" } }, "required": ["actor"] },
      "then": {
        "properties": { "label": { "enum": ["human", null] }, "evidence_class": { "enum": ["human_report", "accessible"] } },
        "if": { "properties": { "label": { "const": "human" } }, "required": ["label"] },
        "then": { "properties": { "provenance": { "properties": { "source": { "enum": ["independent-human-review", "accessibility-review"] } } } } }
      }
    },
    {
      "if": { "properties": { "actor": { "const": "AUTOMATION_CONTROL" } }, "required": ["actor"] },
      "then": {
        "properties": { "label": { "enum": ["automation", null] }, "evidence_class": { "enum": ["automation", "oracle_assisted"] } },
        "if": { "properties": { "label": { "const": "automation" } }, "required": ["label"] },
        "then": { "properties": { "provenance": { "properties": { "source": { "const": "controlled-automation" } } } } }
      }
    },
    {
      "if": { "properties": { "actor": { "const": "AI_AGENT" } }, "required": ["actor"] },
      "then": {
        "properties": { "label": { "enum": ["ai_agent", null] }, "evidence_class": { "enum": ["agent", "oracle_assisted"] } },
        "if": { "properties": { "label": { "const": "ai_agent" } }, "required": ["label"] },
        "then": { "properties": { "provenance": { "properties": { "source": { "const": "independent-agent-review" } } } } }
      }
    }
  ]
}
