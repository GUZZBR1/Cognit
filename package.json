{
  "name": "cognit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    "./client-sdk": {
      "types": "./dist/client-sdk.d.ts",
      "import": "./dist/client-sdk.js"
    }
  },
  "files": [
    "dist/client-sdk.js",
    "dist/client-sdk.d.ts"
  ],
  "scripts": {
