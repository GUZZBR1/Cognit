{
  "name": "cognit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    "./client-sdk": {
      "types": "./dist/client-sdk.d.ts",
      "import": "./dist/client-sdk.js"
    }
  },
  "files": [
    "dist/client-sdk.js",
    "dist/client-sdk.d.ts"
  ],
  "scripts": {
    "check": "node --experimental-strip-types --check src/cognit/session-engine.ts && node --experimental-strip-types --check src/cognit/history-profile-engine.ts && node --experimental-strip-types --check src/cognit/ad-campaign-schema.ts",
    "test": "npm run build:sdk && node --experimental-strip-types --test",
    "test:python": "python3 -m unittest discover -v",
    "build:sdk": "tsc -p tsconfig.sdk.json",
    "test:sdk": "npm run build:sdk && node --test test/sdk/client-sdk.test.js",
    "test:trial-manifest": "node --test test/trial-manifest.test.js",
    "test:human-confirmation": "node --test test/human-confirmation.test.js",
    "check:production-boundary": "npm run build:sdk && node scripts/check-production-boundary.mjs",
    "report:session-signatures": "node scripts/report-session-signatures.mjs",
    "run:playwright": "node scripts/run-playwright.mjs",
    "attack-lab:selenium": "node attack-lab/selenium.js",
    "attack-lab:puppeteer": "node attack-lab/puppeteer.js"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "puppeteer": "^25.16.0",
    "selenium-webdriver": "^4.38.0",
    "typescript": "^7.0.2"
  }
}
